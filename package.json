      "dayjs": "^1.11.23",
      "lucide": "^1.67.0",
      "lucide-react": "^1.67.0",
      "morphicons": "^2.0.2",
      "next": "^16.4.4",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "react-redux": "^9.3.1",
      "sass": "^1.107.1",
      "valibot": "^1.5.0"
   },
   "devDependencies": {
      "@biomejs/biome": "^2.6.4",
      "@feature-sliced/steiger-plugin": "^0.8.2",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
