{
   "name": "nexty",
   "version": "0.10.0",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "next dev",
      "build": "next build",
      "start": "next start",
      "lint": "biome check && tsc --noEmit && steiger ./src",
